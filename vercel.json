{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "includeFiles": "node_modules/{pdf-parse,pdfjs-dist,@napi-rs/canvas,@napi-rs/canvas-linux-x64-gnu,@napi-rs/canvas-linux-x64-musl}/**"
    }
  }
}
