# ==============================================================================
# ZOVO AI PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- AI Models ---
# GEMINI_API_KEY: Required for Gemini multimodal chat, transcription, and reasoning.
GEMINI_API_KEY=""

# --- Authentication & Security ---
# JWT_SECRET: Strong secret key used for signing session JWT tokens.
JWT_SECRET="replace-with-a-secure-random-32-byte-secret"

# --- Supabase Cloud Database & Storage ---
# SUPABASE_URL: Project URL from your Supabase Project Settings -> API (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Service role secret key for server-side operations (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_ANON_KEY: Public/Anonymous client key.
SUPABASE_ANON_KEY=""
